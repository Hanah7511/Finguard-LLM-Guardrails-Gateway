# Copy this file to .env and fill in your own values. Never commit .env.
# LLM (only needed for /chat)
OPENAI_API_KEY=

# Active policy version (default: the newest approved one)
# ACTIVE_POLICY_VERSION=1.4.0

# One secret key per agent, required from policy 1.4.0. Make each one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_KEY_INVESTIGATION=
AGENT_KEY_COMPLIANCE=
AGENT_KEY_SUMMARIZATION=

# Optional: Hugging Face token for higher download limits
# HF_TOKEN=

# PostgreSQL and the encrypted vault (Step 7B). Blank here on purpose; real values go in .env only.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
# 32 random bytes, base64. Losing it makes every stored real value unreadable.
VAULT_MASTER_KEY=


# The key any app must send to the REST door, as the X-API-Key header (Step 7C).
FINGUARD_API_KEY=